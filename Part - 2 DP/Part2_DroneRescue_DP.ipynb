   "source": [
    "## Value Iteration\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eb9d23d6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Value Iteration\n",
    "print('\\n' + '=' * 60)\n",
    "print('DELIVERABLE 2: Dynamic Programming — Value Iteration')\n",
    "print('=' * 60)\n",
    "\n",
    "def value_iteration(env, gamma=GAMMA, theta=THETA):\n",
    "    \"\"\"Compute V* and π* via Value Iteration.\"\"\"\n",
    "    all_states = env.get_all_states()\n",
    "    print(f'Total states to evaluate: {len(all_states)}')\n",
    "    V = {s: 0.0 for s in all_states}\n",
    "    iteration = 0\n",
    "    delta_history = []\n",
    "    start_time = time.time()\n",
    "\n",
    "    while True:\n",
    "        delta = 0\n",
    "        for s in all_states:\n",
    "            if env.is_terminal(s):\n",
    "                continue\n",
    "            v_old = V[s]\n",
    "            action_values = []\n",
    "            for a in env.get_valid_actions(s):\n",
    "                q_value = 0\n",
    "                for prob, next_state, reward, done in env.get_transition_prob(s, a):\n",
    "                    if done:\n",
    "                        q_value += prob * reward\n",
    "                    else:\n",
    "                        q_value += prob * (reward + gamma * V.get(next_state, 0.0))\n",
    "                action_values.append(q_value)\n",
    "            V[s] = max(action_values)\n",
    "            delta = max(delta, abs(v_old - V[s]))\n",
    "\n",
    "        iteration += 1\n",
    "        delta_history.append(delta)\n",
    "        print(f'  Iteration {iteration:4d} | delta = {delta:.8f}')\n",
    "        if delta < theta:\n",
    "            print(f'  → Converged at iteration {iteration}')\n",
    "            break\n",
    "\n",
    "    elapsed = time.time() - start_time\n",
    "\n",
    "    # Extract policy\n",
    "    policy = {}\n",
    "    for s in all_states:\n",
    "        if env.is_terminal(s):\n",
    "            policy[s] = None\n",
    "            continue\n",
    "        best_action, best_value = None, float('-inf')\n",
    "        for a in env.get_valid_actions(s):\n",
    "            q_value = 0\n",
    "            for prob, next_state, reward, done in env.get_transition_prob(s, a):\n",
    "                if done:\n",
    "                    q_value += prob * reward\n",
    "                else:\n",
    "                    q_value += prob * (reward + gamma * V.get(next_state, 0.0))\n",
    "            if q_value > best_value:\n",
    "                best_value = q_value\n",
    "                best_action = a\n",
    "        policy[s] = best_action\n",
    "\n",
    "    return V, policy, {'iterations': iteration, 'runtime_seconds': elapsed,\n",
    "                       'final_delta': delta, 'delta_history': delta_history,\n",
    "                       'num_states': len(all_states)}\n",
    "\n",
    "\n",
    "print('\\nRunning Value Iteration...')\n",
    "V_star, policy_star, vi_info = value_iteration(env)\n",
    "\n",
    "print(f\"\\n--- Value Iteration Results ---\")\n",
    "print(f\"Converged in {vi_info['iterations']} iterations\")\n",
    "print(f\"Runtime: {vi_info['runtime_seconds']:.2f} seconds\")\n",
    "print(f\"Final delta: {vi_info['final_delta']:.6f}\")\n",
    "print(f\"Total states: {vi_info['num_states']}\")\n",
    "\n",
    "initial_state = (0, 0, MAX_BATTERY, 0, 0)\n",
    "print(f\"\\nV*(start state) = {V_star.get(initial_state, 'N/A'):.4f}\")\n",
    "print(f\"π*(start state) = {ACTION_LABELS.get(policy_star.get(initial_state), 'N/A')}\")"
   ]
