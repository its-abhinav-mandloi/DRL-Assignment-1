   "source": [
    "## Policy Evaluation Cross-Check\n",
    "\n",
    "Verify that V_π*(start) ≈ V*(start) by running Policy Evaluation under the extracted greedy policy.  \n",
    "If the difference is within θ, it confirms Value Iteration correctly converged.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pe-crosscheck-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Policy Evaluation Cross-Check (fix: new cell added to verify VI correctness)\n",
    "print('\\n--- Policy Evaluation Cross-Check ---')\n",
    "\n",
    "def policy_evaluation(env, policy, gamma=GAMMA, theta=THETA):\n",
    "    \"\"\"Evaluate a fixed policy to get V_pi.\"\"\"\n",
    "    all_states = env.get_all_states()\n",
    "    V_pi = {s: 0.0 for s in all_states}\n",
    "    while True:\n",
    "        delta = 0\n",
    "        for s in all_states:\n",
    "            if env.is_terminal(s):\n",
    "                continue\n",
    "            a = policy.get(s)\n",
    "            if a is None:\n",
    "                continue\n",
    "            v_old = V_pi[s]\n",
    "            v_new = 0\n",
    "            for prob, next_state, reward, done in env.get_transition_prob(s, a):\n",
    "                if done:\n",
    "                    v_new += prob * reward\n",
    "                else:\n",
    "                    v_new += prob * (reward + gamma * V_pi.get(next_state, 0.0))\n",
    "            V_pi[s] = v_new\n",
    "            delta = max(delta, abs(v_old - v_new))\n",
    "        if delta < theta:\n",
    "            break\n",
    "    return V_pi\n",
    "\n",
    "\n",
    "V_pi_star = policy_evaluation(env, policy_star)\n",
    "\n",
    "v_vi  = V_star.get(initial_state, 0)\n",
    "v_pe  = V_pi_star.get(initial_state, 0)\n",
    "diff  = abs(v_vi - v_pe)\n",
    "\n",
    "print(f'V*(start)    from Value Iteration  : {v_vi:.6f}')\n",
    "print(f'V_π*(start)  from Policy Evaluation: {v_pe:.6f}')\n",
    "print(f'Difference   : {diff:.6f}  (threshold θ = {THETA})')\n",
    "if diff < THETA * 10:\n",
    "    print('✅ Cross-check PASSED — VI converged correctly.')\n",
    "else:\n",
    "    print('❌ Cross-check FAILED — investigate convergence.')"
   ]
